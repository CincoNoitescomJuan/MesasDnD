 const typeIcons=["⚔️","🔥","❄️","⚡","💥","🧪","☠️","✨","💀","🧠","💪","🏹","🗡️","🔨","◽","🧩"];
 const text=full.split(" + ").map(part=>{
   let cut=-1;
   typeIcons.forEach(icon=>{const i=part.indexOf(icon);if(i>=0&&(cut<0||i<cut))cut=i});
