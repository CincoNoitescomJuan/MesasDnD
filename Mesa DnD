function recoverByRest(kind){
 const isLight=kind==="light";
 const label=isLight?"Descanso ligero":"Descanso prolongado";
 let recovered=[],ended=[];
 const recover=o=>o&&o.recovery===kind;
 [data.abilities,data.items,data.effects,data.spells].forEach(arr=>arr.forEach(o=>{
   if(!recover(o))return;
   if(Number(o.usesMax||0)>0){
     o.uses=Number(o.usesMax);
     recovered.push(`${o.icon||"•"} ${o.name}`);
   }
   if("cooldown" in o)o.cooldown=0;
   if(Number(o.durationMax||0)>0 || o.durationMax===Infinity){
     o.durationRemaining=o.durationMax===Infinity?Infinity:Number(o.durationMax||0);
     o.runtimeActive=false;
     // A temporary effect/ability/object is ready to be used again,
     // but its temporary effect is not considered active until used/activated.
     if(o.durationMax!==Infinity && o.category!=="passive" && !data.spells.includes(o))o.active=false;
   }
 }));
 // Every rest refreshes the turn resources.
 ["action","quickAction","reaction","freeAction","movement"].forEach(k=>{
   data.character[k+"Spent"]=0;
 });
 if(kind==="long"){
   data.character.hp=data.character.maxHp;
   data.character.shield=0;
   data.turn=1;
   Object.keys(data.spellSlots||{}).forEach(k=>data.spellSlots[k].current=data.spellSlots[k].max);
 }
 save();render();
 const msg=recovered.length
   ? `🛌 ${label}: ${recovered.length} recurso(s) recuperado(s).`
   : `🛌 ${label}: no hay usos configurados para este descanso.`;
 toast(msg);
}
