  function sendToHost(msg){const c=[...VTT.conns.values()][0];if(c?.open)c.send(msg);else toast('⚠️ Todavía no hay conexión con el DM')}

  function renderPlayers(){const e=$('vttPlayers');if(!e)return;const a=[...VTT.players.values()];e.innerHTML=a.length?a.map(p=>`<div class="vtt-player"><div class="vtt-avatar">${p.avatar?`<img src="${esc2(p.avatar)}">`:'👤'}</div><div><b>${esc2(p.name||'Jugador')}</b>${p.host?'<small>👑 DM / anfitrión</small>':'<small>Jugador</small>'}</div></div>`).join(''):'<div class="muted">Sin jugadores.</div>'}
  function renderRolls(){const e=$('vttRolls');if(!e)return;const a=VTT.state.rolls||[];e.innerHTML=a.slice(-50).reverse().map(r=>`<div class="vtt-roll"><div>${esc2(r.name)} · ${esc2(r.formula)}</div><strong>${r.total}</strong></div>`).join('')||'<div class="muted">Todavía no hay tiradas.</div>'}
