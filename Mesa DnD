function startDuration(o){
 const d=o?.durationMax;
 if(d===Infinity){o.durationRemaining=Infinity;o.runtimeActive=true}
 else if(Number(d)>0){o.durationRemaining=Number(d);o.runtimeActive=true}
 else if(Object.keys(o?.modifiers||{}).length||Object.values(o?.damage||{}).some(Number)||o?.damageStat){
   o.durationRemaining=1;o.runtimeActive=true;o.runtimeOneTurn=true;
 }else{o.durationRemaining=0;o.runtimeActive=false;o.runtimeOneTurn=false}
}

