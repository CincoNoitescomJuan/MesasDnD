  function drawGrid(x,w,h){x.strokeStyle='rgba(255,255,255,.045)';x.lineWidth=1;for(let i=0;i<w;i+=40){x.beginPath();x.moveTo(i,0);x.lineTo(i,h);x.stroke()}for(let i=0;i<h;i+=40){x.beginPath();x.moveTo(0,i);x.lineTo(w,i);x.stroke()}}
  function drawTokens(x){(VTT.state.tokens||[]).forEach(t=>{x.save();x.translate(t.x,t.y);x.beginPath();x.arc(0,0,t.size||25,0,Math.PI*2);x.fillStyle=t.color||'#9b7cff';x.fill();x.strokeStyle='#fff';x.lineWidth=2;x.stroke();if(t.image){const im=new Image();im.onload=()=>{x.save();x.beginPath();x.arc(0,0,(t.size||25)-2,0,Math.PI*2);x.clip();x.drawImage(im,-(t.size||25),-(t.size||25),(t.size||25)*2,(t.size||25)*2);x.restore()};im.src=t.image}x.fillStyle='#fff';x.font='bold 12px system-ui';x.textAlign='center';x.textBaseline='middle';x.fillText(t.label||'?',0,0);x.restore()})}
  function draw(){const stage=$('vttStage'),c=$('vttCanvas');if(!stage||!c)return;const r=stage.getBoundingClientRect(),d=window.devicePixelRatio||1;c.width=Math.max(1,r.width*d);c.height=Math.max(1,r.height*d);c.style.width=r.width+'px';c.style.height=r.height+'px';const x=c.getContext('2d');x.setTransform(d,0,0,d,0,0);x.clearRect(0,0,r.width,r.height);if(VTT.state.background){const im=new Image();im.onload=()=>{x.globalAlpha=.94;x.drawImage(im,0,0,r.width,r.height);x.globalAlpha=1;drawTokens(x)};im.onerror=()=>{x.globalAlpha=1;drawGrid(x,r.width,r.height);drawTokens(x)};im.src=VTT.state.background}else{const g=x.createLinearGradient(0,0,r.width,r.height);g.addColorStop(0,'#151b26');g.addColorStop(1,'#090d13');x.fillStyle=g;x.fillRect(0,0,r.width,r.height);drawGrid(x,r.width,r.height);drawTokens(x)}}

  function updateRoomInfo(){const e=$('vttRoomInfo');if(!e)return;if(!VTT.room){e.innerHTML='<div class="muted">No estás en ninguna mesa.</div>';return}const share=new URL(location.href);share.searchParams.set('room',VTT.room);share.searchParams.set('host',VTT.hostId);e.innerHTML=`<div class="room-code">${esc2(VTT.room)}</div><div class="muted" style="text-align:center;margin-top:6px">Comparte este enlace para que entren los demás.</div><button id="vttCopyRoom" class="btn" style="width:100%;margin-top:7px">🔗 Copiar enlace de mesa</button>`;const b=$('vttCopyRoom');b?.addEventListener('click',()=>{navigator.clipboard?.writeText(share.href).then(()=>toast('🔗 Enlace copiado')).catch(()=>{prompt('Copia este enlace:',share.href)})})}

  function handle(msg,from){
    if(!msg||!msg.type)return;
    if(msg.type==='hello'&&VTT.isHost){
      VTT.players.set(from,{id:from,name:msg.name||'Jugador',host:false});
      const c=VTT.conns.get(from);if(c?.open)c.send({type:'welcome',hostId:VTT.hostId,room:VTT.room,state:clone(VTT.state),players:[...VTT.players.values()]});
      broadcast({type:'players',players:[...VTT.players.values()]},from);renderPlayers();return;
    }
    if(msg.type==='welcome'){VTT.hostId=msg.hostId;VTT.room=msg.room;VTT.state=msg.state||VTT.state;VTT.players.clear();(msg.players||[]).forEach(p=>VTT.players.set(p.id,p));if(VTT.peer)VTT.players.set(VTT.peer.id,{id:VTT.peer.id,name:VTT.name,host:false});renderPlayers();renderRolls();renderChat();draw();setStatus('Conectado a la mesa',true);persistLocal();updateRoomInfo();return;}
    if(msg.type==='players'){VTT.players.clear();(msg.players||[]).forEach(p=>VTT.players.set(p.id,p));if(!VTT.isHost&&VTT.peer)VTT.players.set(VTT.peer.id,{id:VTT.peer.id,name:VTT.name,host:false});renderPlayers();return;}
    if(msg.type==='chat'){VTT.state.chat.push(msg.item);renderChat();if(VTT.isHost)broadcast(msg,from);return;}
    if(msg.type==='roll'){VTT.state.rolls.push(msg.item);renderRolls();showRoll(msg.item);if(VTT.isHost)broadcast(msg,from);return;}
    if(msg.type==='state'){if(!VTT.isHost){VTT.state.characterState=msg.state;};return;}
    if(msg.type==='map'){if(!VTT.isHost){VTT.state.background=msg.background||'';draw();}if(VTT.isHost)broadcast(msg,from);return;}
    if(msg.type==='tokens'){VTT.state.tokens=msg.tokens||[];draw();if(VTT.isHost)broadcast(msg,from);return;}
    if(msg.type==='rollRequest'&&VTT.isHost){const item=msg.item;VTT.state.rolls.push(item);renderRolls();showRoll(item);broadcast({type:'roll',item},from);return;}
    if(msg.type==='chatRequest'&&VTT.isHost){VTT.state.chat.push(msg.item);renderChat();broadcast({type:'chat',item:msg.item},from);return;}
  }

  function wire(c){
    c.on('open',()=>{VTT.conns.set(c.peer,c);if(!VTT.isHost)c.send({type:'hello',name:VTT.name});setStatus('Conectado',true)});
    c.on('data',d=>handle(d,c.peer));
    c.on('close',()=>{VTT.conns.delete(c.peer);if(VTT.isHost){VTT.players.delete(c.peer);broadcast({type:'players',players:[...VTT.players.values()]});renderPlayers()}});
    c.on('error',e=>{toast('⚠️ Conexión: '+(e?.type||'error'))});
  }
  function initPeer(){
    if(VTT.peer)return;
    if(typeof Peer==='undefined'){setStatus('PeerJS no disponible');toast('⚠️ No se ha podido cargar PeerJS. En GitHub Pages se cargará por HTTPS.');return;}
    VTT.peer=new Peer(undefined,{debug:1});
    VTT.peer.on('open',id=>{
      if(VTT.isHost){VTT.hostId=id;VTT.room=VTT.room||roomCode();VTT.players.set(id,{id,name:VTT.name,host:true});setStatus('Mesa creada',true);updateRoomInfo();persistLocal();}
      else if(VTT.pendingHost){const c=VTT.peer.connect(VTT.pendingHost,{reliable:true,metadata:{name:VTT.name}});wire(c)}
    });
    VTT.peer.on('connection',wire);
    VTT.peer.on('error',e=>{setStatus('Error de conexión');toast('⚠️ '+(e?.type||'Error de red'))});
    VTT.peer.on('disconnected',()=>setStatus('Señalización desconectada'));
  }

  function rollDie(sides){return Math.floor(Math.random()*sides)+1}
  function rollDiceSet(dice){let out=[],total=0;for(const d of dice){const n=Math.max(0,Number(d.count)||0),sides=Number(d.sides)||20;for(let i=0;i<n;i++){const result=rollDie(sides);out.push({sides,result});total+=result}}return {dice:out,total}}
  function manualRoll(){
    if(!VTT.peer)return toast('Primero crea o únete a una mesa');
    const die=$('vttManualDie')?.value||'d20',count=Math.max(1,Math.min(50,Number($('vttManualCount')?.value)||1)),modifier=Number($('vttManualModifier')?.value)||0;
    const r=rollDiceSet([{sides:Number(die.slice(1)),count}]);r.total+=modifier;
    const sign=modifier>0?` + ${modifier}`:modifier<0?` - ${Math.abs(modifier)}`:'';
    const formula=`${count}${die}${sign}`;
    publishRoll({name:VTT.name,formula,total:r.total,dice:r.dice,time:Date.now(),source:'Tirada libre',rollType:'manual'});
  }
  function publishRoll(item){VTT.state.rolls.push(item);renderRolls();showRoll(item);const msg={type:'roll',item};if(VTT.isHost)broadcast(msg);else sendToHost({type:'rollRequest',item})}

  function entityHasDamage(o){return (o?.damageParts||normalizeDamageParts(null,o?.damage)).some(p=>DICE.some(k=>Number(p?.[k]))||Number(p?.flat))||(o?.damageStats||[]).length>0}
  function entityHasImpact(o){const d=normalizeImpactDice(o?.impactDice);return DICE.some(k=>Number(d[k]))||Number(o?.impactFlat)||!!o?.addCompetenceToImpact||((o?.impactStats||[]).length>0)}
  function entityDamageParts(o){return o?.damageParts?.length?o.damageParts:normalizeDamageParts(null,o?.damage)}
  function entityDamageRoll(o){let dice=[],total=0;entityDamageParts(o).forEach(p=>{DICE.forEach(k=>{const n=Number(p?.[k]||0);for(let i=0;i<n;i++){const sides=Number(k.slice(1)),r=rollDie(sides);dice.push({sides,result:r});total+=r}});total+=Number(p?.flat||0)});(o?.damageStats||[]).forEach(x=>{total+=derivedStat(x.stat)*Math.max(1,Number(x.mult)||1)});return {dice,total}}
  function entityImpactBonus(o){let total=Number(data.character.precision||0)+Number(o?.impactFlat||0);if(o?.addCompetenceToImpact)total+=Number(data.character.competencia||0);total+=statBonusTotal(o?.impactStats);return total}
  function entityImpactRoll(o){const d=normalizeImpactDice(o?.impactDice),dice=[],base=rollDie(20);dice.push({sides:20,result:base});let total=base+entityImpactBonus(o);DICE.forEach(k=>{const n=Number(d[k]||0);for(let i=0;i<n;i++){const sides=Number(k.slice(1)),r=rollDie(sides);dice.push({sides,result:r});total+=r}});return {dice,total}}
  function formatEntityDamage(o){let p=[];entityDamageParts(o).forEach(part=>{let q=DICE.filter(k=>Number(part?.[k])).map(k=>`${part[k]}${k}`);if(Number(part?.flat))q.push(String(Number(part.flat)));if(q.length)p.push(q.join(' + '))});(o?.damageStats||[]).forEach(x=>p.push(`${Math.max(1,Number(x.mult)||1)}×${N(x.stat)}`));return p.join(' + ')||'Sin dados de daño'}
  function sheetRollItem(o,type){const r=type==='impact'?entityImpactRoll(o):entityDamageRoll(o);const bonus=entityImpactBonus(o);const formula=type==='impact'?`1d20${bonus>=0?' + '+bonus:' - '+Math.abs(bonus)}`:formatEntityDamage(o);return {name:VTT.name,formula:`${o.icon||'🎲'} ${o.name} · ${formula}`,total:r.total,dice:r.dice,time:Date.now(),source:o.name,rollType:type}}

  function vttRollSaved(id,kind,type){
    if(!VTT.peer)return toast('Primero crea o únete a una mesa');
    const arr=kind==='Habilidad'?data.abilities:kind==='Objeto'?data.items:data.spells;
    const o=arr.find(x=>String(x.id)===String(id));if(!o)return toast('No se encontró esa acción en la ficha');
    const item=sheetRollItem(o,type);publishRoll(item);$('vttRollLauncher')?.classList.add('collapsed');
  }
  function renderSheetRolls(){
    const el=$('vttSheetRolls');if(!el)return;
    const source=vttRollCategory==='Habilidad'?data?.abilities||[]:vttRollCategory==='Objeto'?data?.items||[]:data?.spells||[];
    const list=source.filter(o=>entityHasDamage(o)||entityHasImpact(o));
    el.innerHTML=list.map(o=>`<div class="vtt-launch-item"><div class="vtt-launch-icon">${esc(o.icon||'🎲')}</div><div class="vtt-launch-name"><b>${esc(o.name||'Sin nombre')}</b><small>${vttRollCategory}${o.level!==undefined?' · Nivel '+o.level:''}</small></div><div class="vtt-launch-actions">${entityHasImpact(o)?'<button type="button" class="btn small vtt-roll-action" data-roll-id="'+esc2(o.id)+'" data-roll-kind="'+esc2(vttRollCategory)+'" data-roll-type="impact">🎯</button>':''}${entityHasDamage(o)?'<button type="button" class="btn small primary vtt-roll-action" data-roll-id="'+esc2(o.id)+'" data-roll-kind="'+esc2(vttRollCategory)+'" data-roll-type="damage">💥</button>':''}</div></div>`).join('')||`<div class="vtt-launch-empty">No hay ${vttRollCategory.toLowerCase()} con dados configurados.</div>`;
  }
  function showRoll(r){const who=$('vttBigWho'),formula=$('vttBigFormula'),total=$('vttBigTotal'),dice=$('vttBigDice'),box=$('vttBigRoll');if(!box)return;if(who)who.textContent=r.name; if(formula)formula.textContent=r.formula;if(total)total.textContent=r.total;if(dice)dice.innerHTML=(r.dice||[]).map(d=>`<div class="vtt-die" title="d${d.sides}">${d.result}</div>`).join('');box.classList.add('show');clearTimeout(VTT.rollTimer);VTT.rollTimer=setTimeout(()=>box.classList.remove('show'),2800)}

  function openJoinModal(){openModal(`<div class="modalhead"><h2>🔗 Unirse a una mesa</h2><button class="btn small" id="vttCloseJoin">✕</button></div><div class="help">Pega el enlace completo que te ha enviado el DM.</div><div class="field" style="margin-top:12px"><label>Enlace de la mesa</label><input id="vttJoinLink" placeholder="https://.../?room=ABC123&host=peer-id" autocomplete="off"></div><div class="field" style="margin-top:10px"><label>Nombre</label><input id="vttJoinName" value="${esc(VTT.name||data?.character?.name||'Jugador')}"></div><div class="modalfoot"><button class="btn" id="vttCancelJoin">Cancelar</button><button class="btn primary" id="vttConfirmJoin">Entrar en la mesa</button></div>`);$('vttCloseJoin')?.addEventListener('click',closeModal);$('vttCancelJoin')?.addEventListener('click',closeModal);$('vttConfirmJoin')?.addEventListener('click',confirmJoin)}
  function confirmJoin(){const raw=String($('vttJoinLink')?.value||'').trim();if(!raw)return toast('Pega primero el enlace de la mesa');try{const u=new URL(raw,location.href),room=u.searchParams.get('room'),host=u.searchParams.get('host');if(!room||!host)throw new Error('missing');VTT.name=String($('vttJoinName')?.value||'Jugador').trim()||'Jugador';localStorage.setItem('vtt_name',VTT.name);VTT.room=room;VTT.hostId=host;VTT.pendingHost=host;VTT.isHost=false;const clean=new URL(location.href);clean.searchParams.set('room',room);clean.searchParams.set('host',host);history.replaceState({},'',clean.href);closeModal();nav('table');initPeer();updateRoomInfo()}catch(e){toast('❌ Enlace no válido. Debe incluir room y host.')}}
  function createRoom(){if(VTT.peer)return toast('Ya estás conectado a una mesa');VTT.name=prompt('¿Qué nombre quieres usar?',VTT.name||data?.character?.name||'DM')||'DM';localStorage.setItem('vtt_name',VTT.name);VTT.isHost=true;VTT.room=null;nav('table');setStatus('Creando mesa…');initPeer()}
  function leaveRoom(){VTT.conns.forEach(c=>c.close());VTT.conns.clear();VTT.players.clear();if(VTT.peer)VTT.peer.destroy();VTT.peer=null;VTT.room=null;VTT.hostId=null;VTT.pendingHost=null;VTT.isHost=false;VTT.state={background:'',tokens:[],rolls:[],chat:[]};setStatus('Sin conexión');renderPlayers();renderRolls();renderChat();draw();updateRoomInfo();const u=new URL(location.href);u.searchParams.delete('room');u.searchParams.delete('host');history.replaceState({},'',u.href)}
  function sendChat(){const i=$('vttChatInput'),text=String(i?.value||'').trim();if(!text||!VTT.peer)return;i.value='';const item={name:VTT.name,text,time:Date.now()};if(VTT.isHost){VTT.state.chat.push(item);renderChat();broadcast({type:'chat',item})}else sendToHost({type:'chatRequest',item})}
  function addToken(){if(!VTT.peer)return toast('Conecta primero a una mesa');if(!VTT.isHost)return toast('Solo el DM puede añadir tokens');const label=prompt('Nombre/abreviatura del token','NPC');if(label===null)return;const t={id:Math.random().toString(36).slice(2),x:150+(VTT.state.tokens.length%5)*80,y:150+Math.floor(VTT.state.tokens.length/5)*80,size:28,label:label.slice(0,8),color:'#9b7cff'};VTT.state.tokens.push(t);draw();broadcast({type:'tokens',tokens:VTT.state.tokens})}
  function setBackground(){if(!VTT.isHost)return toast('Solo el DM puede cambiar el fondo');const u=prompt('URL pública de la imagen de fondo','');if(u===null)return;VTT.state.background=u.trim();draw();broadcast({type:'map',background:VTT.state.background})}

  window.vttCreateRoom=createRoom;window.vttJoinRoom=openJoinModal;window.vttLeaveRoom=leaveRoom;window.vttSendChat=sendChat;window.vttAddToken=addToken;window.vttSetBackground=setBackground;window.vttToggleLauncher=()=>$('vttRollLauncher')?.classList.toggle('collapsed');window.vttSelectRollCategory=kind=>{vttRollCategory=kind;document.querySelectorAll('.vtt-launch-tab').forEach(b=>b.classList.toggle('active',b.dataset.rollKind===kind));renderSheetRolls()};window.vttRollSaved=vttRollSaved;window.vttManualRoll=manualRoll;
  window.vttRoll=(die='d20')=>{if(!VTT.peer)return toast('Primero crea o únete a una mesa');const sides=Number(String(die).replace('d',''))||20;const r=rollDiceSet([{sides,count:1}]);publishRoll({name:VTT.name,formula:'1d'+sides,total:r.total,dice:r.dice,time:Date.now(),source:'Tirada libre',rollType:'manual'})};

  document.addEventListener('click',e=>{const b=e.target.closest('.vtt-roll-action');if(!b)return;vttRollSaved(b.dataset.rollId,b.dataset.rollKind,b.dataset.rollType)});
  $('vttManualModifier')?.addEventListener('keydown',e=>{if(e.key==='Enter')manualRoll()});
  $('vttManualCount')?.addEventListener('input',updateManualPreview);$('vttManualDie')?.addEventListener('change',updateManualPreview);$('vttManualModifier')?.addEventListener('input',updateManualPreview);
  function updateManualPreview(){const die=$('vttManualDie')?.value||'d20',count=Math.max(1,Number($('vttManualCount')?.value)||1),mod=Number($('vttManualModifier')?.value)||0;const sign=mod>0?` + ${mod}`:mod<0?` - ${Math.abs(mod)}`:'';const e=$('vttManualPreview');if(e)e.textContent=`${count}${die}${sign}`}
  $('vttStage')?.addEventListener('pointerdown',e=>{if(!VTT.isHost)return;const r=$('vttCanvas').getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top,t=[...VTT.state.tokens].reverse().find(q=>Math.hypot(q.x-x,q.y-y)<(q.size||25));if(!t)return;VTT.drag={t,dx:x-t.x,dy:y-t.y};$('vttCanvas').setPointerCapture(e.pointerId)});
  $('vttStage')?.addEventListener('pointermove',e=>{if(!VTT.drag)return;const r=$('vttCanvas').getBoundingClientRect();VTT.drag.t.x=e.clientX-r.left-VTT.drag.dx;VTT.drag.t.y=e.clientY-r.top-VTT.drag.dy;draw()});
  $('vttStage')?.addEventListener('pointerup',()=>{if(VTT.drag){VTT.drag=null;broadcast({type:'tokens',tokens:VTT.state.tokens})}});
  window.addEventListener('resize',draw);

  const oldRender=window.render;window.render=function(){oldRender.apply(this,arguments);renderSheetRolls();updateManualPreview()};
  const oldSave=window.save;window.save=function(){oldSave.apply(this,arguments);if(!VTT.peer)return;const msg={type:'state',state:clone(data)};if(VTT.isHost)broadcast(msg);else sendToHost(msg)};
  const oldNav=window.nav;window.nav=function(v){if(v==='table'){document.querySelectorAll('.view').forEach(e=>e.classList.remove('active'));$('view-table')?.classList.add('active');document.querySelectorAll('[data-view]').forEach(e=>e.classList.toggle('active',e.dataset.view==='table'));$('title').textContent='Mesa virtual';$('subtitle').textContent='Sala online, mapa, chat, historial y tiradas compartidas.';draw();updateRoomInfo();return}oldNav(v)};

  renderPlayers();renderRolls();renderChat();renderSheetRolls();updateManualPreview();updateRoomInfo();draw();
  if(initialRoom&&initialHost){setTimeout(()=>{VTT.name=prompt('¿Qué nombre quieres usar?',VTT.name||data?.character?.name||'Jugador')||'Jugador';localStorage.setItem('vtt_name',VTT.name);VTT.room=initialRoom;VTT.hostId=initialHost;VTT.pendingHost=initialHost;VTT.isHost=false;initPeer();},300)}
})();
</script>
