function impactFormula(){
 const parts=[];
 const dice=impactDiceFormula();
 if(dice) parts.push(dice);

 let fixed=Number(data.character.precision||0)+modifierTotal("precisión");
 const fixedExtras=[];
 if(fixed) fixedExtras.push(String(fixed));

 const addFixed=o=>{if(Number(o?.impactFlat||0))fixedExtras.push(String(Number(o.impactFlat)))};
 const addComp=o=>{if(o?.addCompetenceToImpact)fixedExtras.push(String(Number(data.character.competencia||0)))};
 const addStats=o=>{const n=statBonusTotal(o?.impactStats);if(n)fixedExtras.push(String(n))};

 data.resources.filter(resourceBonusesActive).forEach(addFixed);
 data.effects.filter(e=>e.runtimeActive).forEach(addFixed);
 data.abilities.filter(a=>a.runtimeActive).forEach(addFixed);
 data.items.filter(i=>i.runtimeActive).forEach(addFixed);
 data.spells.filter(s=>s.runtimeActive).forEach(addFixed);

 data.resources.filter(resourceBonusesActive).forEach(addComp);
 data.effects.filter(e=>e.runtimeActive).forEach(addComp);
 data.abilities.filter(a=>a.runtimeActive).forEach(addComp);
 data.items.filter(i=>i.runtimeActive).forEach(addComp);
 data.spells.filter(s=>s.runtimeActive).forEach(addComp);

 data.resources.filter(resourceBonusesActive).forEach(addStats);
 data.effects.filter(e=>e.runtimeActive).forEach(addStats);
 data.abilities.filter(a=>a.runtimeActive).forEach(addStats);
 data.items.filter(i=>i.runtimeActive).forEach(addStats);
 data.spells.filter(s=>s.runtimeActive).forEach(addStats);

 parts.push(...fixedExtras);
 return parts.join(" + ")||"0";
}
