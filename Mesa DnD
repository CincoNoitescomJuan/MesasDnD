function damageFormula(){
 const groups={};
 const add=(type,d)=>{const k=type||"sin_tipo";if(!groups[k])groups[k]={d4:0,d6:0,d8:0,d10:0,d12:0,d20:0,flat:0};DICE.forEach(x=>groups[k][x]+=Number(d?.[x]||0));groups[k].flat+=Number(d?.flat||0)};
 const addEntity=e=>{(e.damageParts||normalizeDamageParts(null,e.damage)).forEach(p=>add(p.type,p));(e.damageStats||[]).forEach(s=>add(s.type,{flat:derivedStat(s.stat)*Math.max(1,Number(s.mult)||1)}))};
 data.resources.filter(resourceBonusesActive).forEach(addEntity);activeEffects().forEach(addEntity);data.abilities.filter(a=>a.runtimeActive).forEach(addEntity);data.items.filter(i=>i.runtimeActive).forEach(addEntity);data.spells.filter(s=>s.runtimeActive).forEach(addEntity);
 return Object.entries(groups).map(([type,d])=>{let p=DICE.filter(x=>d[x]).map(x=>`${d[x]}${x}`);if(d.flat)p.push(String(d.flat));return p.length?`${p.join(" + ")} ${damageTypeLabel(type)}`:""}).filter(Boolean).join(" + ")||"0";
}
