<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Character Hub V4</title>
<style>
:root{--bg:#080b10;--panel:#10151e;--panel2:#171e29;--panel3:#0c1118;--line:#293343;--text:#eef3fa;--muted:#8d99ab;--accent:#9b7cff;--accent2:#c8baff;--good:#54d6a0;--warn:#f1c65a;--danger:#ef6b78;--blue:#5ba8ff;--cyan:#62d8e9;--r:17px;--shadow:0 15px 45px #0008}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:radial-gradient(circle at 10% 0,#21183b 0,transparent 30%),radial-gradient(circle at 100% 20%,#102033 0,transparent 30%),var(--bg);color:var(--text);font-family:Inter,system-ui,Segoe UI,sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer}
.app{display:flex;min-height:100vh}.side{width:238px;position:sticky;top:0;height:100vh;background:#090c12eF;border-right:1px solid var(--line);padding:20px 13px;display:flex;flex-direction:column;gap:15px;backdrop-filter:blur(15px)}.brand{padding:8px 12px 17px}.brand b{font-size:18px;letter-spacing:.06em}.brand small{display:block;color:var(--muted);margin-top:3px}.nav{display:grid;gap:6px}.nav button,.mobile button{border:0;background:transparent;color:var(--muted);padding:11px 12px;border-radius:11px;text-align:left}.nav button:hover,.nav button.active,.mobile button.active{background:var(--panel2);color:var(--text)}.nav button.active{box-shadow:inset 3px 0 var(--accent)}.sidefoot{margin-top:auto;color:var(--muted);font-size:10px;padding:10px}
main{width:min(1500px,100%);margin:auto;padding:23px;flex:1}.top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:18px}.top h1{margin:0;font-size:28px}.top p{margin:5px 0;color:var(--muted);font-size:12px}.top-actions{display:flex;gap:7px;flex-wrap:wrap}.btn{border:1px solid var(--line);background:var(--panel);color:var(--text);padding:9px 12px;border-radius:10px}.btn:hover{background:var(--panel2);border-color:#4b5870}.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}.btn.danger{color:#ff9da6}.btn.small{font-size:11px;padding:7px 9px}.view{display:none}.view.active{display:block}
.grid{display:grid;gap:13px}.g2{grid-template-columns:repeat(2,minmax(0,1fr))}.g3{grid-template-columns:repeat(3,minmax(0,1fr))}.g4{grid-template-columns:repeat(4,minmax(0,1fr))}.g6{grid-template-columns:repeat(6,minmax(0,1fr))}.card{background:linear-gradient(145deg,#151b26f5,#0d1219f5);border:1px solid var(--line);border-radius:var(--r);padding:15px;box-shadow:var(--shadow)}
.hero{display:grid;grid-template-columns:1.35fr .8fr;gap:13px}.hero-main{min-height:200px;display:flex;flex-direction:column;justify-content:space-between}.eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:.15em;color:var(--accent2)}.name{font-size:36px;font-weight:900;margin:5px 0}.muted{color:var(--muted);font-size:11px}.chips{display:flex;gap:6px;flex-wrap:wrap}.chip{background:var(--panel3);border:1px solid var(--line);border-radius:999px;padding:7px 9px;font-size:10px}.chip b{color:#fff}.turn{text-align:center;display:flex;flex-direction:column;justify-content:center}.turn small{color:var(--muted);letter-spacing:.17em}.turn strong{font-size:53px;line-height:1;margin:8px 0 15px}.next{padding:14px;width:100%;font-size:14px}
.res{display:grid;gap:11px}.reshead{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-bottom:5px}.bar{height:9px;background:#080b10;border:1px solid var(--line);border-radius:99px;overflow:hidden}.bar i{display:block;height:100%;background:var(--accent);border-radius:inherit;width:0}.bar.hp i{background:var(--good)}.bar.sh i{background:var(--blue)}.bar.ma i{background:var(--accent)}
.section{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:20px 0 10px}.section h2{margin:0;font-size:16px}.section span{font-size:10px;color:var(--muted)}
.stat{background:#0d1219;border:1px solid var(--line);border-radius:13px;padding:11px;text-align:center}.stat .ico{font-size:18px}.stat .sn{font-size:9px;color:var(--muted);text-transform:uppercase;margin-top:4px}.stat .sv{font-size:22px;font-weight:850;margin-top:2px}
.resource{display:flex;justify-content:space-between;align-items:center;gap:8px}.resource b{font-size:20px}.resource .mini{display:flex;gap:4px}.mini button{width:29px;height:29px;border:1px solid var(--line);background:var(--panel3);color:#fff;border-radius:8px}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(245px,1fr));gap:11px}.item{background:#0e131b;border:1px solid var(--line);border-radius:15px;padding:13px;min-height:145px;transition:.15s}.item:hover{transform:translateY(-2px);border-color:#48556c}.itemtop{display:flex;gap:9px}.icon{width:41px;height:41px;border-radius:11px;background:#19202e;display:grid;place-items:center;font-size:20px;flex:none}.item h3{font-size:14px;margin:0 0 3px}.desc{font-size:11px;line-height:1.5;color:#b8c2d0;margin:10px 0}.tags{display:flex;gap:4px;flex-wrap:wrap}.tag{border:1px solid var(--line);border-radius:99px;padding:4px 6px;font-size:9px;color:#aeb8c7}.good{color:var(--good)}.warn{color:var(--warn)}.bad{color:var(--danger)}.effect{border-left:3px solid var(--accent)}.effect.warn{border-left-color:var(--warn)}.effect.debuff{border-left-color:var(--danger)}
.actions{display:flex;gap:5px;margin-top:10px}.actions .btn{flex:1}.empty{border:1px dashed var(--line);border-radius:13px;padding:30px;text-align:center;color:var(--muted);grid-column:1/-1}
.editor-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.field{display:grid;gap:5px}.field label{font-size:10px;color:var(--muted)}input,textarea,select{width:100%;background:#0a0f15;color:var(--text);border:1px solid var(--line);border-radius:10px;padding:9px;outline:none}input:focus,textarea:focus,select:focus{border-color:var(--accent)}textarea{min-height:80px;resize:vertical}.checks{display:flex;gap:6px;flex-wrap:wrap}.check{display:flex;align-items:center;gap:5px;padding:7px 8px;border:1px solid var(--line);background:var(--panel3);border-radius:9px;font-size:10px}.check input{width:auto}
.modal{position:fixed;inset:0;background:#000b;display:none;place-items:center;padding:16px;z-index:30}.modal.open{display:grid}.modalbox{width:min(780px,100%);max-height:93vh;overflow:auto;background:#141a25;border:1px solid var(--line);border-radius:19px;padding:18px;box-shadow:var(--shadow)}.modalhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}.modalhead h2{margin:0;font-size:18px}.modalfoot{display:flex;justify-content:flex-end;gap:7px;margin-top:15px}.help{background:#0c1219;border:1px solid var(--line);border-radius:10px;padding:10px;font-size:10px;color:#aeb8c7;line-height:1.5}.toast{position:fixed;right:17px;bottom:17px;background:#171e29;border:1px solid var(--line);padding:11px 13px;border-radius:11px;box-shadow:var(--shadow);opacity:0;transform:translateY(10px);transition:.2s;z-index:50}.toast.show{opacity:1;transform:none}.mobile{display:none}
@media(max-width:950px){.side{display:none}.mobile{position:fixed;display:flex;bottom:0;left:0;right:0;z-index:20;background:#090c12f7;border-top:1px solid var(--line);justify-content:space-around;padding:5px}.mobile button{text-align:center;font-size:9px;padding:6px}.main{padding:15px 12px 80px}.hero{grid-template-columns:1fr}.g4,.g6{grid-template-columns:repeat(3,1fr)}}
@media(max-width:600px){.top{display:block}.top-actions{margin-top:10px}.g2,.g3{grid-template-columns:1fr}.g4,.g6{grid-template-columns:repeat(2,1fr)}.editor-grid{grid-template-columns:1fr}.name{font-size:30px}.cards{grid-template-columns:1fr}}

/* V5: estado, activación y daño */
.quick-panel{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.derived{background:#0b1017;border:1px solid var(--line);border-radius:13px;padding:12px}
.derived .big{font-size:24px;font-weight:900;margin-top:4px}
.sync-row{display:flex;align-items:center;justify-content:space-between;gap:8px}
.toggle{position:relative;width:42px;height:24px;display:inline-block;flex:none}.toggle input{display:none}.toggle span{position:absolute;inset:0;border-radius:99px;background:#252d3a;border:1px solid var(--line);transition:.15s}.toggle span:before{content:"";position:absolute;width:18px;height:18px;left:2px;top:2px;border-radius:50%;background:#9aa5b6;transition:.15s}.toggle input:checked+span{background:#493b75;border-color:var(--accent)}.toggle input:checked+span:before{transform:translateX(18px);background:#fff}
.inactive{opacity:.42;filter:saturate(.5)}.active-mark{color:var(--good);font-weight:800}.inactive-mark{color:var(--muted)}
.damage-box{border:1px solid var(--line);background:#0b1017;border-radius:13px;padding:12px}.damage-result{font-size:18px;font-weight:900;word-break:break-word}.damage-copy{margin-top:8px}
.dice-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:7px}.dice-grid .field{min-width:0}.dice-grid input{text-align:center}
.reset{color:#ff9da6;border-color:#66333a}.danger-box{border:1px solid #5c3037;background:#211318;padding:12px;border-radius:12px}
@media(max-width:700px){.quick-panel{grid-template-columns:1fr}.dice-grid{grid-template-columns:repeat(3,1fr)}}


.emoji-picker{background:#0b1017;border:1px solid var(--line);border-radius:12px;padding:10px;margin-top:6px}.emoji-current{display:flex;align-items:center;gap:10px;padding:8px;background:#101722;border-radius:10px;margin-bottom:9px}.emoji-current span:first-child{font-size:27px}.emoji-cat{margin-top:9px}.emoji-list{display:flex;flex-wrap:wrap;gap:4px;margin-top:5px}.emoji-btn{width:34px;height:34px;border:1px solid transparent;background:#151c27;border-radius:8px;font-size:19px;padding:0}.emoji-btn:hover,.emoji-btn.selected{border-color:var(--accent);background:#302650}
.mod-total{display:flex;align-items:center;justify-content:space-between;padding:11px 12px;background:#0b1017;border:1px solid var(--line);border-radius:12px}.mod-total b{font-size:22px}


details.emoji-details{margin-top:6px;background:#0b1017;border:1px solid var(--line);border-radius:12px;overflow:hidden}
details.emoji-details>summary{cursor:pointer;list-style:none;padding:10px;color:#c7d0dd;font-size:11px;display:flex;align-items:center;justify-content:space-between}
details.emoji-details>summary::-webkit-details-marker{display:none}
details.emoji-details>summary:after{content:"＋";font-size:16px;color:var(--accent)}
details.emoji-details[open]>summary:after{content:"−"}
.derived-stat{position:relative}.stat-base{font-size:9px;color:var(--muted);margin-top:2px}.stat-bonus{font-size:10px;color:var(--good);font-weight:800;min-height:15px}
.grant-box{background:#0b1017;border:1px solid var(--line);border-radius:12px;padding:12px;margin-top:10px}.grant-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}.grant-grid input{text-align:center}
.category-title{display:flex;align-items:center;gap:8px}.category-title .dot{width:8px;height:8px;border-radius:50%;background:var(--accent);display:inline-block}.category-title.passive .dot{background:var(--good)}
@media(max-width:700px){.grant-grid{grid-template-columns:repeat(2,1fr)}}

.resource-total-note{font-size:9px;color:var(--good);margin-top:3px}
.combat-active-only{margin-top:8px}

.resource-big{font-size:30px;font-weight:900;line-height:1}
.resource-card-wide{min-height:100px}
.hp-fast{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.hp-fast button{min-width:42px}

/* ===== V6 polish ===== */
.v6-resource .resource b{font-size:30px}
.v6-resource .resource-note{margin-top:5px;font-size:11px;color:var(--muted)}
.v6-resource .resource-bonus{color:var(--good);font-weight:800}
.v6-resource .resource-base{color:var(--muted)}
.v6-competence{border:1px solid var(--line);border-radius:14px;padding:16px;background:#0b1017;min-height:92px}
.v6-competence .big{font-size:30px;font-weight:900;margin-top:7px}
.v6-quick-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
@media(max-width:800px){.v6-quick-grid{grid-template-columns:1fr}}

.rest-panel{border:1px solid rgba(139,92,246,.38);background:linear-gradient(135deg,rgba(139,92,246,.10),rgba(15,23,42,.70));padding:16px;margin-bottom:14px}
.rest-info{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px}
.rest-info>div{display:flex;flex-direction:column;gap:4px}
.rest-info span{font-size:.82rem;color:var(--muted)}
.rest-buttons{display:flex;gap:10px;flex-wrap:wrap}
.rest-buttons .btn{min-height:42px}
@media(max-width:700px){.rest-info{grid-template-columns:1fr}.rest-buttons .btn{width:100%}}

.cost-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.cost-option{display:grid;grid-template-columns:auto 1fr 70px;align-items:center;gap:7px;border:1px solid var(--line);border-radius:10px;padding:9px;background:#0b1017}
.cost-option input[type=number]{width:70px}
.impact-box{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:10px;padding:14px 16px;border:1px solid rgba(56,189,248,.3);border-radius:14px;background:rgba(56,189,248,.06)}
.impact-box span{font-size:24px}
.turn-combat{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:12px 0}
@media(max-width:700px){.cost-grid{grid-template-columns:1fr}.turn-combat{flex-direction:column;align-items:stretch}}

.cost-option{cursor:pointer;transition:.15s ease}
.cost-option:has(.costCheck:checked){border-color:rgba(139,92,246,.65);background:rgba(139,92,246,.08)}
.impact-box b{font-size:18px}
<style>
.mode-pill{display:inline-flex;margin-top:9px;padding:5px 8px;border:1px solid var(--line);border-radius:999px;background:var(--panel3);font-size:9px;color:var(--muted);gap:5px}
.mode-pill strong{color:var(--accent2)}
<style>
.resource-custom{min-height:180px}
.resource-counter{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:18px 0 10px}
.resource-counter>div{font-size:30px;font-weight:900;text-align:center;min-width:90px}
.resource-counter>div span{font-size:14px;color:var(--muted);font-weight:600}
.resource-counter .btn{width:42px;height:42px;font-size:20px}
.resource-custom .bar{margin-top:9px}
.resource-custom .bar i{display:block;height:100%;background:var(--accent);border-radius:inherit}
.resource-cost-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:8px;margin-top:7px}
.resource-cost-option{display:grid!important;grid-template-columns:auto 1fr 75px;align-items:center;gap:7px}
.resource-cost-option input[type=checkbox]{width:auto}
.resource-cost-option .resourceCostAmount{min-width:0}
.spell-slots{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}
.spell-slot{background:var(--panel3);border:1px solid var(--line);border-radius:12px;padding:10px;display:grid;grid-template-columns:1fr auto;gap:7px;align-items:center}
.slot-controls{display:flex;align-items:center;gap:5px}
.slot-controls strong{min-width:25px;text-align:center}
.spell-slot>input{grid-column:1/-1;padding:6px}
@media(max-width:850px){.spell-slots{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:560px){.spell-slots{grid-template-columns:1fr}}
<style>
.spell-slot-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.slot-fields{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px}
.slot-fields label{font-size:10px;color:var(--muted);display:flex;flex-direction:column;gap:4px}
.slot-fields input{width:100%;box-sizing:border-box;padding:7px}
@media(max-width:560px){.slot-fields{grid-template-columns:1fr}}
<style>
#combatSpellSlots .spell-slots{margin-bottom:12px}
#combatSpells .item{border-left:3px solid var(--accent)}
<style>
.sheet-switcher{display:flex;align-items:center;gap:5px}
.sheet-switcher select{max-width:240px;min-height:38px}
@media(max-width:900px){.sheet-switcher select{max-width:170px}}
@media(max-width:600px){.sheet-switcher{width:100%}.sheet-switcher select{flex:1;max-width:none}}
<style>
.altered-state-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-bottom:18px}
.altered-state{border:1px solid var(--line);background:var(--panel);border-radius:13px;padding:12px}
.altered-state.state-active{border-color:var(--accent);box-shadow:0 0 0 1px rgba(150,110,255,.15)}
.altered-state-main{display:flex;align-items:flex-start;gap:9px}
.altered-state-icon{font-size:23px;line-height:1.1}
.altered-state-info{flex:1;min-width:0}
.altered-state-info h3{margin:0 0 3px;font-size:14px}
.altered-state-info p{margin:0;color:var(--muted);font-size:11px;line-height:1.4}
.altered-state-controls{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:10px;padding-top:9px;border-top:1px solid var(--line);font-size:11px;font-weight:700}
.altered-state-controls label{font-size:10px;color:var(--muted);display:flex;align-items:center;gap:6px}
.altered-state-controls input{width:64px;padding:6px}
@media(max-width:800px){.altered-state-grid{grid-template-columns:1fr}}
<style>
.stat-bonus-box{margin:10px 0}.stat-bonus-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:7px}.stat-bonus-head>label{font-size:11px;color:var(--muted)}.stat-bonus-rows{display:flex;flex-direction:column;gap:7px}.stat-bonus-row{display:grid;grid-template-columns:minmax(0,1fr) 90px 18px auto;align-items:center;gap:6px}.stat-bonus-row select,.stat-bonus-row input{width:100%;box-sizing:border-box}.stat-bonus-row span{text-align:center;color:var(--muted);font-size:11px}.stat-bonus-empty{border:1px dashed var(--line);border-radius:8px;padding:8px}@media(max-width:600px){.stat-bonus-row{grid-template-columns:minmax(0,1fr) 70px 15px auto}}
<style>
/* Secciones plegables del HUD de combate */
.combat-collapse{margin:0 0 12px;border:1px solid var(--line);border-radius:14px;background:rgba(15,20,30,.55);overflow:hidden}
.combat-collapse>summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:10px;min-height:52px;padding:0 16px;font-weight:700;user-select:none}
.combat-collapse>summary::-webkit-details-marker{display:none}
.combat-collapse>summary::before{content:"▸";font-size:14px;color:var(--accent);transition:transform .18s ease}
.combat-collapse[open]>summary::before{transform:rotate(90deg)}
.combat-collapse>summary>span{font-size:15px}
.combat-collapse>summary>small{margin-left:auto;color:var(--muted);font-size:10px;font-weight:500}
.combat-collapse>summary .collapse-action{margin-left:10px;flex:0 0 auto}
.combat-collapse[open]>summary{border-bottom:1px solid var(--line)}
.collapse-body{padding:12px}
.collapse-body>.grid,.collapse-body>.cards{margin:0}
.combat-collapse .section{margin-top:0}
@media(max-width:650px){
 .combat-collapse>summary{padding:0 11px;min-height:48px}
 .combat-collapse>summary>span{font-size:13px}
 .combat-collapse>summary>small{display:none}
 .combat-collapse>summary .collapse-action{margin-left:auto}
 .collapse-body{padding:9px}
}
<style>
.damage-part-labels,.damage-part-row{display:grid;grid-template-columns:150px repeat(6,minmax(42px,1fr)) 75px 34px;gap:5px;align-items:center}
.damage-part-labels{margin:7px 0 4px;color:var(--muted);font-size:9px;text-align:center}.damage-part-labels span:first-child{text-align:left}
.damage-part-row{margin-bottom:7px}.damage-part-row input,.damage-part-row select{width:100%;box-sizing:border-box;min-width:0}.damage-part-row .btn{padding:6px}
.damage-parts-box{margin:10px 0}.damage-stat-row{display:grid;grid-template-columns:minmax(120px,1fr) 70px 14px minmax(120px,1fr) auto;gap:6px;align-items:center}.damage-stat-row select,.damage-stat-row input{width:100%;box-sizing:border-box}
.damage-typed{margin-top:7px;color:var(--muted);font-size:12px;font-weight:600}
@media(max-width:850px){.damage-part-labels,.damage-part-row{grid-template-columns:120px repeat(6,minmax(34px,1fr)) 65px 30px}.damage-stat-row{grid-template-columns:1fr 60px 12px 1fr auto}}


/* V23 — acabado visual */
body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;background:radial-gradient(circle at 12% 8%,rgba(155,124,255,.14),transparent 27%),radial-gradient(circle at 88% 20%,rgba(91,168,255,.11),transparent 28%),radial-gradient(circle at 50% 100%,rgba(84,214,160,.06),transparent 32%);}
body::after{content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;opacity:.16;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(to bottom,black,transparent 85%);}
.card,.item,.derived,.spell-folder{transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease;}
.card:hover,.item:hover{transform:translateY(-1px);border-color:#46536b;box-shadow:0 18px 55px rgba(0,0,0,.28),0 0 24px rgba(155,124,255,.035);}
.btn{transition:transform .14s ease,box-shadow .14s ease,background .14s ease,border-color .14s ease;}
.btn:hover{transform:translateY(-1px);box-shadow:0 8px 22px rgba(0,0,0,.22);}
