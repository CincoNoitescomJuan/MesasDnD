  const initialHost=url.searchParams.get('host');
  let vttRollCategory='Habilidad';

  function esc2(s=''){return String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}
  function roomCode(){return Math.random().toString(36).slice(2,8).toUpperCase()}
  function setStatus(t,on=false){const e=$('vttStatus'),d=$('vttDot');if(e)e.textContent=t;if(d)d.classList.toggle('online',on)}
